# Example environment variables
# Copy this file to .env.local and update with your values.
# .env.local is ignored by git.

# ─── RFQ email notification (required to receive quote emails) ───
# Resend API key. Create one at resend.com → API Keys (sending permission only).
RESEND_API_KEY=
# Inbox that receives RFQ notifications (the quote form is an export enquiry).
NOTIFICATION_EMAIL=exports@jaydevgroup.co.in
# Sender. jaydevgroup.co.in is the VERIFIED sending domain in Resend -
# do not send from an unverified domain or delivery will fail.
NOTIFICATION_FROM_EMAIL=Jaydev Group <noreply@jaydevgroup.co.in>

# ─── Optional extra webhook (Zapier / Make / Google Sheets) - leave blank if unused ───
QUOTE_WEBHOOK_URL=
